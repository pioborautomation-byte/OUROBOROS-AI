{
	"compilerOptions": {
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"types": ["bun"],
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"noUnusedLocals": false,
		"noFallthroughCasesInSwitch": true,
		"resolveJsonModule": true
	},
	"include": ["src/**/*.ts", "tests/**/*.ts"]
}
